{
  "name": "noida-sports-talent-hunt",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sport-pages.mjs",
    "test:visual": "npm run build && playwright test",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist --compatibility-date=2026-06-24",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=noidatalenthunt"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.6.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.20.0"
  }
}
